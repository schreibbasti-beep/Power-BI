// ============================================================
// Ampel_Measures_v2.dax
// 4-Farben-Ampelsystem – Auditor-Qualifikationen
//
// Rot    = abgelaufen (Tage_bis_Ablauf < 0)
// Orange = 0–90 Tage
// Gelb   = 91–180 Tage
// Grün   = mehr als 180 Tage
// Grau   = kein Gültig_bis_Korrekt gesetzt
//
// Voraussetzung: Qualifikations_Status_Korrektur.pq ist als
// primäre Tabelle eingebunden (oder Korrektur direkt integriert),
// sodass die Spalten Gültig_bis_Korrekt und Gültig_ab_Korrekt
// in Qualifikations_Status verfügbar sind.
// ============================================================


// ------------------------------------------------------------
// BERECHNETE SPALTEN – in Tabelle Qualifikations_Status anlegen
// Modellierung → Neue Spalte
// Hinweis: TODAY() wird zum Refresh-Zeitpunkt ausgewertet.
// ------------------------------------------------------------

// Tage_bis_Ablauf (Berechnete Spalte)
// Negativ = abgelaufen | BLANK = kein Datum gesetzt
//
// Tage_bis_Ablauf =
// DATEDIFF(
//     TODAY(),
//     Qualifikations_Status[Gültig_bis_Korrekt],
//     DAY
// )


// Ampel_Farbe (Berechnete Spalte – für Slicer & bedingte Formatierung)
// "Sortierung nach Spalte" → Ampel_Sortierung setzen!
//
// Ampel_Farbe =
// VAR Tage = Qualifikations_Status[Tage_bis_Ablauf]
// RETURN
//     IF(
//         ISBLANK(Qualifikations_Status[Gültig_bis_Korrekt]),
//         "⚪ Kein Datum",
//         IF(Tage < 0,    "🔴 Rot",
//         IF(Tage <= 90,  "🟠 Orange",
//         IF(Tage <= 180, "🟡 Gelb",
//                         "🟢 Grün")))
//     )


// Ampel_Sortierung (Berechnete Spalte – Sortierspalte für Ampel_Farbe)
// 1 = Rot (höchste Dringlichkeit oben) … 5 = Kein Datum
//
// Ampel_Sortierung =
// VAR Tage = Qualifikations_Status[Tage_bis_Ablauf]
// RETURN
//     IF(ISBLANK(Qualifikations_Status[Gültig_bis_Korrekt]), 5,
//     IF(Tage < 0,    1,
//     IF(Tage <= 90,  2,
//     IF(Tage <= 180, 3,
//                     4))))


// Dringlichkeits_Bucket (Berechnete Spalte – für Slicer)
//
// Dringlichkeits_Bucket =
// VAR Tage = Qualifikations_Status[Tage_bis_Ablauf]
// RETURN
//     IF(ISBLANK(Qualifikations_Status[Gültig_bis_Korrekt]), "Kein Datum",
//     IF(Tage <  0,    "Abgelaufen",
//     IF(Tage <= 90,   "0–90 Tage",
//     IF(Tage <= 180,  "91–180 Tage",
//                      "> 180 Tage (OK)"))))


// ------------------------------------------------------------
// MEASURES – Modellierung → Neues Measure
// ------------------------------------------------------------


// ------------------------------------------------------------
// 1) Tage_bis_Ablauf_M
//    Measure-Version für Tabellenvisuals und KPI-Karten.
//    Nutzt Gültig_bis_Korrekt; fällt auf Gültig_bis zurück,
//    falls Korrekturlogik noch nicht integriert ist.
// ------------------------------------------------------------
Tage_bis_Ablauf_M =
VAR GueltigBis =
    COALESCE(
        MAX(Qualifikations_Status[Gültig_bis_Korrekt]),
        MAX(Qualifikations_Status[Gültig_bis])
    )
RETURN
    IF(ISBLANK(GueltigBis), BLANK(), DATEDIFF(TODAY(), GueltigBis, DAY))


// ------------------------------------------------------------
// 2) Ampel_Status_M
//    Textwert für Tooltips, Filter und Slicer.
// ------------------------------------------------------------
Ampel_Status_M =
VAR Tage = [Tage_bis_Ablauf_M]
RETURN
    IF(ISBLANK(Tage),  "Kein Datum",
    IF(Tage < 0,       "Rot",
    IF(Tage <= 90,     "Orange",
    IF(Tage <= 180,    "Gelb",
                       "Grün"))))


// ------------------------------------------------------------
// 3) Ampel_Symbol_M
//    Unicode-Kreise für kompakte Anzeige in Tabelle/Matrix.
//    🔴 Rot | 🟠 Orange | 🟡 Gelb | 🟢 Grün | ⚪ Kein Datum
// ------------------------------------------------------------
Ampel_Symbol_M =
VAR Tage = [Tage_bis_Ablauf_M]
RETURN
    IF(ISBLANK(Tage),  "⚪",
    IF(Tage < 0,       "🔴",
    IF(Tage <= 90,     "🟠",
    IF(Tage <= 180,    "🟡",
                       "🟢"))))


// ------------------------------------------------------------
// 4) Ampel_Farbe_HEX
//    Hexfarbcode für bedingte Formatierung per Feldwert.
//    Format → Bedingte Formatierung → Hintergrundfarbe
//    → Formatierungsart: Feldwert → dieses Measure auswählen.
// ------------------------------------------------------------
Ampel_Farbe_HEX =
VAR Tage = [Tage_bis_Ablauf_M]
RETURN
    IF(ISBLANK(Tage),  "#808080",   // Grau      – kein Datum
    IF(Tage < 0,       "#C00000",   // Dunkelrot – abgelaufen
    IF(Tage <= 90,     "#FF8C00",   // Orange    – 0–90 Tage
    IF(Tage <= 180,    "#FFD700",   // Gelb      – 91–180 Tage
                       "#00B050")))) // Grün      – > 180 Tage


// ------------------------------------------------------------
// 5) KPI-Zählmeasures (für Karten-Visuals)
//    Voraussetzung: Berechnete Spalte Tage_bis_Ablauf ist vorhanden.
// ------------------------------------------------------------

Anzahl_Rot =
CALCULATE(
    COUNTROWS(Qualifikations_Status),
    NOT ISBLANK(Qualifikations_Status[Tage_bis_Ablauf]),
    Qualifikations_Status[Tage_bis_Ablauf] < 0
)

Anzahl_Orange =
CALCULATE(
    COUNTROWS(Qualifikations_Status),
    Qualifikations_Status[Tage_bis_Ablauf] >= 0,
    Qualifikations_Status[Tage_bis_Ablauf] <= 90
)

Anzahl_Gelb =
CALCULATE(
    COUNTROWS(Qualifikations_Status),
    Qualifikations_Status[Tage_bis_Ablauf] >= 91,
    Qualifikations_Status[Tage_bis_Ablauf] <= 180
)

Anzahl_Gruen =
CALCULATE(
    COUNTROWS(Qualifikations_Status),
    Qualifikations_Status[Tage_bis_Ablauf] > 180
)

Anzahl_Gesamt =
COUNTROWS(Qualifikations_Status)

Anzahl_Kein_Datum =
CALCULATE(
    COUNTROWS(Qualifikations_Status),
    ISBLANK(Qualifikations_Status[Gültig_bis_Korrekt])
)


// ------------------------------------------------------------
// 6) Anteil_Kritisch_Prozent
//    Anteil abgelaufener Qualifikationen (Rot) am Gesamtbestand.
//    Format als Prozent mit 1 Dezimalstelle.
// ------------------------------------------------------------
Anteil_Kritisch_Prozent =
DIVIDE([Anzahl_Rot], [Anzahl_Gesamt], 0)


// ------------------------------------------------------------
// 7) Hat_Qualifikation
//    Visual-Filter gegen Phantomzeilen aus der Datum-Tabelle.
//    Als Visual-Ebenen-Filter setzen: Hat_Qualifikation = 1
//    UND Auto Datum/Uhrzeit in den Optionen deaktivieren.
// ------------------------------------------------------------
Hat_Qualifikation =
IF(COUNTROWS(Qualifikations_Status) > 0, 1, BLANK())


// ------------------------------------------------------------
// 8) Fruehestes_Ablaufdatum
//    Nächstes Gültig_bis_Korrekt-Datum im aktuellen Filterkontext.
//    Nützlich für Tooltip: "Nächste Fälligkeit am ..."
// ------------------------------------------------------------
Frühestes_Ablaufdatum =
MINX(
    FILTER(
        Qualifikations_Status,
        NOT ISBLANK(Qualifikations_Status[Gültig_bis_Korrekt])
    ),
    Qualifikations_Status[Gültig_bis_Korrekt]
)
